(
    format: "bitwerk",
    version: 1,
    name: "half adder",
    circuit: (
        components: [
            (id: (0), kind: Switch(on: false), pos: (x: 0, y: 0)),
            (id: (1), kind: Switch(on: false), pos: (x: 0, y: 6)),
            (id: (2), kind: Gate(op: Xor, inputs: 2), pos: (x: 8, y: 0)),
            (id: (3), kind: Gate(op: And, inputs: 2), pos: (x: 8, y: 8)),
            (id: (4), kind: Led, pos: (x: 16, y: 1)),
            (id: (5), kind: Led, pos: (x: 16, y: 9)),
        ],
        wires: [
            (id: (0), from: (component: (0), pin: 0), to: (component: (2), pin: 0)),
            (id: (1), from: (component: (0), pin: 0), to: (component: (3), pin: 0), via: [(x: 4, y: 1), (x: 4, y: 9)]),
            (id: (2), from: (component: (1), pin: 0), to: (component: (2), pin: 1), via: [(x: 6, y: 7), (x: 6, y: 3)]),
            (id: (3), from: (component: (1), pin: 0), to: (component: (3), pin: 1), via: [(x: 6, y: 7), (x: 6, y: 11)]),
            (id: (4), from: (component: (2), pin: 2), to: (component: (4), pin: 0)),
            (id: (5), from: (component: (3), pin: 2), to: (component: (5), pin: 0)),
        ],
    ),
)
